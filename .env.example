# Octopus Relay configuration. Copy to .env and fill in; never commit .env.

# --- Recommended ----------------------------------------------------------------------------------------

# Domain name (required only when using compose.caddy.yaml for automatic HTTPS).
RELAY_DOMAIN=relay.example.com

# Canonical public URL (optional when behind a proxy with RELAY_TRUST_PROXY=true, recommended in production).
# RELAY_PUBLIC_URL=https://relay.example.com

# Owner password for the built-in Web console & browser device-code login (min 8 chars).
# Leave both RELAY_PASSWORD and RELAY_ACCESS_KEY empty to use the first-run /setup wizard instead.
RELAY_PASSWORD=

# Optional Access Key for browser-free one-click client sign-in (min 16 chars).
# Generate with: echo "ork_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
# Tip: You can also leave this blank and generate/rotate keys inside the Web console (/account).
# RELAY_ACCESS_KEY=

# --- Optional (defaults shown) --------------------------------------------------------------------------

# Trust X-Forwarded-Proto / X-Forwarded-Host / X-Forwarded-For / CF-Connecting-IP from your reverse proxy.
RELAY_TRUST_PROXY=true

# Display name shown in the Web console and /v1/info.
# RELAY_NAME=Octopus Relay

# Owner display name shown in Octopus clients.
# RELAY_OWNER_NAME=Owner

# Host port published by compose.yaml (bound to 127.0.0.1 only).
# RELAY_PORT=8080

# Signing secret (base64, >= 32 bytes). Auto-generated and saved in /data/secret.key when omitted.
# RELAY_SECRET=

# Limits (0 disables monthly traffic limit and idle tunnel timeout).
# RELAY_MAX_DEVICES=32
# RELAY_MAX_HOSTS=32
# RELAY_MAX_TUNNELS=128
# RELAY_MAX_TUNNELS_PER_HOST=32
# RELAY_MONTHLY_BYTES=0
# RELAY_IDLE_SECONDS=0
